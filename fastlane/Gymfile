# Fastlane gym (used internally by Ionic Appflow) can incorrectly auto-detect
# a Cordova iOS 8 app as visionOS on newer Xcode builds.
# Keep this setting explicit: OneSignal XCFramework supports iOS, not visionOS.
destination("generic/platform=iOS")

# Cordova iOS 8 uses Swift Package Manager targets (including Cordova_Cordova).
# Appflow manually signs only the main App target; pass Team ID to *every*
# xcodebuild target, including these package dependencies.
# This does not replace the Appflow-installed Apple Distribution certificate/profile.
xcargs("DEVELOPMENT_TEAM=F2BCHMBHU9")

# Appflow passes CODE_SIGN_IDENTITY globally even though it has already
# configured the App target for manual Distribution signing. Swift package
# targets must not inherit that global override. The wrapper removes only
# the command-line identity during archive; app target signing stays intact.
# Fastlane evaluates Gymfile in the project context: __dir__ is not guaranteed
# to point at the fastlane/ folder. Resolve from the repository working directory.
appflow_wrapper = File.expand_path("scripts/appflow-xcodebuild.sh", Dir.pwd)
raise "Appflow xcodebuild wrapper missing: #{appflow_wrapper}" unless File.file?(appflow_wrapper)
xcodebuild_command("bash #{appflow_wrapper}")
